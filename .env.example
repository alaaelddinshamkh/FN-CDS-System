# Template only. All production values are intentionally omitted.
# Configure in the server hosting dashboard; preview.mjs does not load this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Owner's verified Supabase Auth user UUID. Never allow public self-assignment.
FN_SUPERADMIN_UID=
# Optional Web Push. Keep the private key server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional hospital gateway. Disabled by default.
HOSPITAL_GATEWAY_URL=
HOSPITAL_GATEWAY_TOKEN=
HOSPITAL_DISPATCH_ENABLED=false
# DB is a D1 binding, not a string environment variable.
# AUTH_FETCH and PUSH_FETCH are test-only dependency overrides.

# Application data backend (server-only)
FN_DATABASE_MODE=supabase
FN_DATABASE_KEY=
# Set true only during a controlled migration; remove when complete.
FN_MIGRATION_LOCK=false
